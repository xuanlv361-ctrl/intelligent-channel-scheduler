WEIMETA_UAT_BASE_URL=https://api-uat.weimeta.cn
WEIMETA_UAT_API_KEY=
# Preferred environment-scoped keys. They are never returned to the browser.
WEIMETA_CHINA_UAT_API_KEY=
WEIMETA_OVERSEAS_API_KEY=
WEIMETA_CHINA_UAT_REAL_EXECUTION_ENABLED=false
WEIMETA_OVERSEAS_REAL_EXECUTION_ENABLED=false
WEIMETA_REAL_EXECUTION_ENABLED=false
WEIMETA_ALLOWED_HOSTS=api-uat.weimeta.cn
WEIMETA_REQUEST_TIMEOUT_SECONDS=30
WEIMETA_MAX_TOKENS_LIMIT=
# Empty/null disables only the local daily limit; external account and provider quotas still apply.
WEIMETA_DAILY_REQUEST_LIMIT=
WEIMETA_DAILY_BUDGET_CNY=
WEIMETA_MAX_REQUEST_COST_CNY=0.20
WEIMETA_UAT_ENVIRONMENT=uat
ROUTING_CONSOLE_DATABASE_PATH=
ROUTING_CONSOLE_EVIDENCE_DIR=
UAT_SESSION_CREDENTIAL_ENABLED=true
# Optional override. Default: %LOCALAPPDATA%\IntelligentChannelScheduler\credentials
# Files contain AES-256-GCM ciphertext only; the DEK is protected by DPAPI CurrentUser.
UAT_PERSISTENT_CREDENTIAL_DIRECTORY=
# Legacy in-memory session settings remain only for upgrade compatibility.
UAT_SESSION_CREDENTIAL_TTL_MINUTES=30
UAT_MAX_ACTIVE_CREDENTIAL_SESSIONS=20
UAT_SESSION_COOKIE_NAME=rqc_uat_session
UAT_SESSION_COOKIE_SECURE=false
UAT_ALLOW_LOCALHOST_INSECURE_COOKIE=true
UAT_FRONTEND_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5173,http://localhost:5173
UAT_LOG_SYNC_MAX_RANGE_HOURS=168
UAT_LOG_SYNC_CLOCK_SKEW_SECONDS=300
UAT_PERSISTENT_SESSION_ENABLED=false
UAT_PERSISTENT_SESSION_TTL_HOURS=8
UAT_PERSISTENT_SESSION_MAX_TTL_HOURS=24
UAT_PERSISTENT_SESSION_ALLOWED_ORIGINS=https://uat.weimeta.cn,https://admin-uat.weimeta.cn
UAT_PERSISTENT_SESSION_MAX_VAULT_BYTES=4194304
UAT_PERSISTENT_SESSION_MAX_ITEM_COUNT=512
UAT_PERSISTENT_SESSION_MAX_VALUE_BYTES=262144
# Optional exact Web Storage key allowlist. Empty permits safe key names subject to all other limits.
UAT_PERSISTENT_SESSION_ALLOWED_STORAGE_KEYS=
# ROUTING_CONSOLE_TEST_MODE and WEIMETA_TEST_TRANSPORT are intentionally omitted.
# scripts/run_local_e2e.ps1 sets both only inside its disposable local test process.

# Enterprise ingress. Development remains loopback-only by default. LAN and
# production profiles fail closed until explicit TLS, host, origin and trusted
# proxy values are supplied. DNS, certificates and firewall rules are external
# deployment configuration and are not generated by the application.
ROUTING_CONSOLE_DEPLOYMENT_PROFILE=development
ROUTING_CONSOLE_BIND_HOST=127.0.0.1
ROUTING_CONSOLE_TLS_MODE=disabled
ROUTING_CONSOLE_ALLOWED_HOSTS=127.0.0.1:5174,localhost:5174
ROUTING_CONSOLE_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5173,http://localhost:5173
UAT_LOCAL_API_HOSTS=127.0.0.1:5174,localhost:5174
ROUTING_CONSOLE_TRUSTED_PROXY_CIDRS=
# Automatic price-catalog reads are disabled by default. Enabling the worker
# still requires a configured approved adapter and an enabled schedule.
PRICE_BACKGROUND_SYNC_ENABLED=false
PRICE_BACKGROUND_SYNC_SECONDS=3600
PRICE_SYNC_NETWORK_ENABLED=false
# Optional one-time, server-side historical UAT billing export. The CSV stays
# outside the web public directory and raw API-key/IP columns are never stored.
HISTORICAL_UAT_CSV_PATH=E:\lx\调用日志_20260730_172539.csv
