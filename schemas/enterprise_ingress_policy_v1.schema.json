{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://routing-quality-console.local/schemas/enterprise_ingress_policy_v1.schema.json",
  "title": "Enterprise ingress policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "default_profile", "external_configuration_status", "profiles"],
  "properties": {
    "schema_version": {"const": "enterprise_ingress_policy_v1"},
    "policy_version": {"type": "string", "minLength": 1},
    "default_profile": {"enum": ["development", "lan", "production"]},
    "external_configuration_status": {
      "type": "object",
      "additionalProperties": {"const": "pending_external_configuration"}
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "lan", "production"],
      "properties": {
        "development": {"$ref": "#/$defs/profile"},
        "lan": {"$ref": "#/$defs/profile"},
        "production": {"$ref": "#/$defs/profile"}
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bind_host", "tls_mode", "allowed_hosts", "allowed_origins", "trusted_proxy_cidrs", "reject_untrusted_forwarding", "limits"],
      "properties": {
        "bind_host": {"type": "string", "minLength": 1},
        "tls_mode": {"enum": ["disabled", "direct", "trusted_proxy"]},
        "allowed_hosts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "allowed_origins": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "not": {"pattern": "\\*"}}},
        "trusted_proxy_cidrs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
        "reject_untrusted_forwarding": {"type": "boolean"},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximum_request_body_bytes", "maximum_header_count", "maximum_header_bytes", "request_timeout_seconds", "global_concurrency", "scoped_concurrency", "global_requests_per_window", "scoped_requests_per_window", "sensitive_requests_per_window", "rate_window_seconds"],
          "properties": {
            "maximum_request_body_bytes": {"type": "integer", "minimum": 1},
            "maximum_header_count": {"type": "integer", "minimum": 1},
            "maximum_header_bytes": {"type": "integer", "minimum": 1},
            "request_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
            "global_concurrency": {"type": "integer", "minimum": 1},
            "scoped_concurrency": {"type": "integer", "minimum": 1},
            "global_requests_per_window": {"type": "integer", "minimum": 1},
            "scoped_requests_per_window": {"type": "integer", "minimum": 1},
            "sensitive_requests_per_window": {"type": "integer", "minimum": 1},
            "rate_window_seconds": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    }
  }
}
