{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "formal_agent_skill_invocation_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["invocation_id", "skill_id", "arguments", "decision_id", "evidence_ids"],
  "properties": {
    "invocation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "skill_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "arguments": {"type": "object"},
    "decision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "evidence_ids": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}}
  }
}
